---
import { ImageField } from "@exdst-sitecore-content-sdk/astro/components/Image.astro";
import AstroImage from "@exdst-sitecore-content-sdk/astro/components/AstroImage.astro";

const image: ImageField = Astro.props.image;
const inverted: boolean = Astro.props.inverted;
---

<div class={`icon-accent ${inverted ? "inverted" : ""}`}>
  <AstroImage field={image} />
</div>
